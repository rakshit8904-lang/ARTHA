# Copy to .env and fill in. Never commit .env.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///artha_dev.sqlite3
APP_BASE_URL=http://localhost:5000
REQUIRE_EMAIL_VERIFICATION=false
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_BYTES=2097152
MAX_IMPORT_ROWS=5000
# SMTP is needed to send real verification emails. Leave empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Artha AI provider configuration (keep keys server-side; never commit real values)
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
